# Copy to .env and adjust. Booleans accept True/False (also 1/0, yes/no).

# Production-safe defaults: set DEBUG=True only for local development.
DEBUG=False
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DJANGO_SETTINGS_MODULE=config.settings.pro
ADMIN_URL=admin/
TIME_ZONE=UTC
LANGUAGE_CODE=en
SITE_ID=1
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
# Set to True when the panel is served over HTTPS (secure cookies, HTTPS redirect).
HTTPS_ONLY=False

# Database. With docker compose, the db service is created from POSTGRES_*:
# keep them in sync with PRODB_URL.
# Other formats: mysql://user:pass@host/db, sqlite:///db.sqlite3
POSTGRES_DB=jasmin
POSTGRES_USER=jasmin
POSTGRES_PASSWORD=jasmin
PRODB_URL=postgres://jasmin:jasmin@db:5432/jasmin
DEVDB_URL=sqlite:///db.sqlite3

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Jasmin jcli (telnet) management interface.
TELNET_HOST=127.0.0.1
TELNET_PORT=8990
TELNET_USERNAME=jcliadmin
TELNET_PW=jclipwd
TELNET_TIMEOUT=10

# Default credentials for "Send SMS" (Jasmin HTTP API and SMPP server).
HTTP_HOST=http://127.0.0.1
HTTP_PORT=1401
HTTP_USERNAME=foo
HTTP_PASSWORD=bar

SMPP_HOST=127.0.0.1
SMPP_PORT=2775
SMPP_SYSTEM_ID=foo
SMPP_PASSWORD=bar

SUBMIT_LOG=False

# API Rate Limiting (requests per minute)
API_THROTTLE_ANON=20/minute
API_THROTTLE_USER=120/minute
