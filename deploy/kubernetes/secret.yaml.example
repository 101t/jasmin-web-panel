# Copy to secret.yaml (do NOT commit secret.yaml) and fill in production values.
# Or create imperatively:
#   kubectl -n jasmin-web create secret generic jasmin-web-secret \
#     --from-literal=SECRET_KEY="$(python3 -c 'import secrets; print(secrets.token_urlsafe(50))')" \
#     --from-literal=FIELD_ENCRYPTION_KEY="$(python3 -c 'import secrets; print(secrets.token_urlsafe(50))')" \
#     --from-literal=PRODB_URL="postgres://jasmin:CHANGE_ME@postgres-service:5432/jasmin" \
#     --from-literal=TELNET_USERNAME="jcliadmin" \
#     --from-literal=TELNET_PW="CHANGE_ME"
apiVersion: v1
kind: Secret
metadata:
  name: jasmin-web-secret
  namespace: jasmin-web
type: Opaque
stringData:
  SECRET_KEY: "REPLACE_WITH_50_CHAR_RANDOM_SECRET"
  FIELD_ENCRYPTION_KEY: "REPLACE_WITH_50_CHAR_RANDOM_ENCRYPTION_KEY"
  PRODB_URL: "postgres://jasmin:REPLACE_PASSWORD@postgres-service:5432/jasmin"
  TELNET_USERNAME: "jcliadmin"
  TELNET_PW: "REPLACE_JCLI_PASSWORD"
  REDIS_PASSWORD: ""
